[Unit]
Description=Holonightd Daemon - Lightweight daemon for routine maintenance automation
Documentation=https://github.com/lebedenko/holonightd
After=network.target local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/holonightd
Restart=on-failure
RestartSec=5s
KillMode=mixed

# Security and sandboxing options
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
