FROM archlinux:latest

# Update package database and install build, test, coverage, and static check tools
RUN pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
        base-devel \
        cmake \
        git \
        ninja \
        pkgconf \
        gtest \
        gcovr \
        clang \
        gcc \
        task \
    && pacman -Scc --noconfirm
